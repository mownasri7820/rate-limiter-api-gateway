# Copy values into your shell / hosting provider. Never commit real secrets.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-characters-long-random-secret
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_SECONDS=60
SERVER_PORT=8080
